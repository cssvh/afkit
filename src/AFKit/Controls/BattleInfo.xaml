<UserControl x:Class="AFKit.Controls.BattleInfo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AFKit.Services"
             Width="300" FontFamily="Tahoma, Segoe UI" FontSize="10" Foreground="White"
             TextOptions.TextRenderingMode="Grayscale">
  <!-- V2: strip below the battle in the window, with the same information as the grid watermarks:
       session summary, record and the 5 latest captures. DataContext = AFKit.Models.TaskbarCell.
       Drawing width 300 (the same as BattleCell); the window scales everything together. -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis"/>
    <SolidColorBrush x:Key="InfoLabel" Color="#C9C2C7"/>
    <SolidColorBrush x:Key="Gold" Color="#FFCC33"/>

    <Style x:Key="LabelText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource InfoLabel}"/>
      <Setter Property="FontSize" Value="9"/>
    </Style>
    <Style x:Key="ValueText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- a capture in a compact row: round portrait, name, level, ★, time; the seals below -->
    <DataTemplate x:Key="CaptureRowTemplate">
      <Border BorderBrush="{Binding BorderBrush}" BorderThickness="3,0,0,0" CornerRadius="3"
              Background="#12FFFFFF" Padding="5,3,6,3" Margin="0,0,0,3">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Grid Width="22" Height="22" VerticalAlignment="Center">
            <Ellipse Fill="#1FFFFFFF"/>
            <Ellipse Visibility="{Binding HasPortrait, Converter={StaticResource BoolVis}}">
              <Ellipse.Fill>
                <ImageBrush ImageSource="{Binding Portrait}" Stretch="UniformToFill"
                            RenderOptions.BitmapScalingMode="NearestNeighbor"/>
              </Ellipse.Fill>
            </Ellipse>
          </Grid>

          <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="White" MaxWidth="140"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding Level}" Foreground="{StaticResource InfoLabel}" FontSize="9"
                         Margin="5,0,0,0" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Text="★" FontFamily="Segoe UI Symbol" FontSize="10"
                         Foreground="{StaticResource Gold}" Margin="4,0,0,0" VerticalAlignment="Center"
                         Visibility="{Binding Shiny, Converter={StaticResource BoolVis}}"/>
              <TextBlock Grid.Column="4" Text="{Binding Time}" Foreground="{StaticResource InfoLabel}" FontSize="9"
                         Margin="6,0,0,0" VerticalAlignment="Center"/>
            </Grid>

            <ItemsControl ItemsSource="{Binding Seals}" Margin="0,2,0,0" Focusable="False"
                          Visibility="{Binding HasSeals, Converter={StaticResource BoolVis}}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{Binding Background}" CornerRadius="3" Padding="3,0" Margin="0,0,3,1">
                    <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}" FontSize="8.5" FontWeight="Bold"/>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Border Background="#B8100A0E" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="8" Padding="7,5,7,4"
          Visibility="{Binding HasInfo, Converter={StaticResource BoolVis}}">
    <StackPanel>
      <!-- session summary: 4 columns (label on top, value below) -->
      <Grid Margin="0,0,0,1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,4,0">
          <TextBlock Text="{loc:T Taskbar.LblTime}" Style="{StaticResource LabelText}"/>
          <TextBlock Text="{Binding Time}" Style="{StaticResource ValueText}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="0,0,4,0">
          <TextBlock Text="{loc:T Taskbar.LblXp}" Style="{StaticResource LabelText}"/>
          <TextBlock Text="{Binding XpPerHour}" Style="{StaticResource ValueText}"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Margin="0,0,4,0">
          <TextBlock Text="{loc:T Taskbar.LblGold}" Style="{StaticResource LabelText}"/>
          <TextBlock Text="{Binding GoldPerHour}" Style="{StaticResource ValueText}"/>
        </StackPanel>
        <StackPanel Grid.Column="3">
          <TextBlock Text="{loc:T Taskbar.LblProfit}" Style="{StaticResource LabelText}"/>
          <TextBlock Text="{Binding ProfitPerHour}" Style="{StaticResource ValueText}" Foreground="{Binding ProfitBrush}"/>
        </StackPanel>
      </Grid>

      <!-- session record: gold card -->
      <Border Margin="0,5,0,0" BorderBrush="{StaticResource Gold}" BorderThickness="1" CornerRadius="6"
              Background="#1FFFCC33" Padding="5,3,5,1"
              Visibility="{Binding HasRecord, Converter={StaticResource BoolVis}}">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
            <TextBlock Text="&#x1F3C6;" FontFamily="Segoe UI Emoji" FontSize="10" VerticalAlignment="Center"/>
            <TextBlock Text="{loc:T Taskbar.LblRecord}" Foreground="{StaticResource Gold}" FontWeight="Bold" FontSize="9.5"
                       Margin="4,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <ContentControl Content="{Binding Record}" ContentTemplate="{StaticResource CaptureRowTemplate}"
                          Focusable="False" IsTabStop="False"/>
        </StackPanel>
      </Border>

      <!-- latest captures -->
      <ItemsControl ItemsSource="{Binding Recent}" ItemTemplate="{StaticResource CaptureRowTemplate}"
                    Margin="0,5,0,0" Focusable="False"
                    Visibility="{Binding HasRecent, Converter={StaticResource BoolVis}}"/>
    </StackPanel>
  </Border>
</UserControl>
