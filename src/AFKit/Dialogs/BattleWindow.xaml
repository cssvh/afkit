<Window x:Class="AFKit.Dialogs.BattleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AFKit.Controls"
        xmlns:loc="clr-namespace:AFKit.Services"
        Title="{loc:T Battle.Title}" FontFamily="{StaticResource Ui}"
        Width="300" Height="400" MinWidth="120" MinHeight="70"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" ShowActivated="False"
        Icon="pack://application:,,,/Assets/afkit.ico"
        MouseLeftButtonDown="OnDrag">
  <Window.ContextMenu>
    <ContextMenu>
      <MenuItem x:Name="OverlayItem" Header="{loc:T Battle.Overlay}" IsCheckable="True" Click="OnOverlayClicked"/>
      <Separator/>
      <MenuItem Header="{loc:T Battle.Hide}" Click="OnHideClicked"/>
    </ContextMenu>
  </Window.ContextMenu>

  <!-- Almost invisible background: keeps the window "grabbable" so it can be dragged from any point.
       A discreet frame shows up on hover to show the limits. -->
  <Border x:Name="Frame" Background="#01000000" CornerRadius="10" BorderThickness="1" BorderBrush="Transparent">
    <!-- Drawing 300 wide: the battle (300×170) and, below it, the info strip (summary, record and
         latest captures). Everything scales with the window; the DataContext is the profile's TaskbarCell. -->
    <Viewbox Stretch="Uniform" Margin="6" VerticalAlignment="Top">
      <StackPanel x:Name="DrawingPanel" Width="300">
        <controls:BattleCell Height="170"/>
        <controls:BattleInfo x:Name="InfoStrip" Margin="0,4,0,0"/>
      </StackPanel>
    </Viewbox>
  </Border>
</Window>
