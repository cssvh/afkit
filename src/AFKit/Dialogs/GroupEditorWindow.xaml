<Window x:Class="AFKit.Dialogs.GroupEditorWindow"
        FontFamily="{StaticResource Ui}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AFKit.Services"
        Title="{loc:T Group.Title}" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource Panel}" Foreground="{StaticResource Fg}">
  <StackPanel Margin="22">
    <Label Content="{loc:T Group.Name}"/>
    <TextBox x:Name="NameBox"/>
    <Label Content="{loc:T Dlg.Color}"/>
    <ItemsControl x:Name="Swatches">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Width="26" Height="26" Margin="0,0,6,0" CornerRadius="13" BorderThickness="2"
                  BorderBrush="Transparent" Cursor="Hand" MouseLeftButtonDown="OnSwatchClicked" Tag="{Binding}">
            <Ellipse Fill="{Binding}" Margin="2"/>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" Margin="0,10,0,0" Visibility="Collapsed"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="{loc:T Dlg.Cancel}" Style="{StaticResource TextButton}" IsCancel="True" Margin="0,0,8,0"/>
      <Button Content="{loc:T Dlg.Save}" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnSave"/>
    </StackPanel>
  </StackPanel>
</Window>
