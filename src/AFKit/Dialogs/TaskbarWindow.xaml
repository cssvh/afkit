<Window x:Class="AFKit.Dialogs.TaskbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AFKit.Services"
        Title="{loc:T Battle.TitlePlural}" FontFamily="{StaticResource Ui}"
        Width="360" Height="170" MinWidth="160" MinHeight="80"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" ShowActivated="False"
        Icon="pack://application:,,,/Assets/afkit.ico"
        MouseLeftButtonDown="OnDrag">
  <Window.ContextMenu>
    <ContextMenu>
      <MenuItem x:Name="OverlayItem" Header="{loc:T Battle.Overlay}" IsCheckable="True" Click="OnOverlayClicked"/>
      <Separator/>
      <MenuItem Header="{loc:T Battle.Hide}" Click="OnHideClicked"/>
    </ContextMenu>
  </Window.ContextMenu>

  <!-- Almost invisible background: keeps the window "grabbable" so it can be dragged from any point.
       A discreet frame shows up on hover to show the limits. -->
  <Border x:Name="Frame" Background="#01000000" CornerRadius="10" BorderThickness="1" BorderBrush="Transparent">
    <Grid>
      <ItemsControl x:Name="Cells" Margin="6">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="{Binding Columns, RelativeSource={RelativeSource AncestorType=Window}}"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <!-- Each cell has a fixed 320×150 drawing that scales with the window. -->
            <Viewbox Stretch="Uniform" Margin="2">
              <Grid Width="320" Height="150">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.Resources>
                  <DropShadowEffect x:Key="TextShadow" BlurRadius="4" ShadowDepth="1" Opacity="0.9" Color="Black"/>
                </Grid.Resources>

                <!-- ===== Your Pokémon ===== -->
                <Grid Grid.Column="0" Margin="4,0">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <TextBlock Text="{Binding MeText}" Foreground="White" FontSize="13" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"
                             Effect="{StaticResource TextShadow}"/>
                  <Border Grid.Row="1" Height="7" Width="120" Margin="0,4,0,0" CornerRadius="4" Background="#99000000"
                          BorderBrush="#66FFFFFF" BorderThickness="1" HorizontalAlignment="Center">
                    <Border CornerRadius="3" Background="#3FB97A" RenderTransformOrigin="0,0.5">
                      <Border.RenderTransform>
                        <ScaleTransform ScaleX="{Binding MeHp}"/>
                      </Border.RenderTransform>
                    </Border>
                  </Border>
                  <Image Grid.Row="2" Source="{Binding MeFrame}" Width="96" Height="96" VerticalAlignment="Bottom"
                         HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Grid>

                <!-- ===== Enemy (combat only) ===== -->
                <Grid x:Name="foe" Grid.Column="1" Margin="4,0" Visibility="Collapsed">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <TextBlock Text="{Binding FoeText}" Foreground="White" FontSize="13" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"
                             Effect="{StaticResource TextShadow}"/>
                  <Border Grid.Row="1" Height="7" Width="120" Margin="0,4,0,0" CornerRadius="4" Background="#99000000"
                          BorderBrush="#66FFFFFF" BorderThickness="1" HorizontalAlignment="Center">
                    <Border CornerRadius="3" Background="#E5534B" RenderTransformOrigin="0,0.5">
                      <Border.RenderTransform>
                        <ScaleTransform ScaleX="{Binding FoeHp}"/>
                      </Border.RenderTransform>
                    </Border>
                  </Border>
                  <Image Grid.Row="2" Source="{Binding FoeFrame}" Width="96" Height="96" VerticalAlignment="Bottom"
                         HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                  <!-- move effect (from the game itself) over the enemy -->
                  <Image Grid.Row="2" Source="{Binding EffectFrame}" Width="96" Height="96" VerticalAlignment="Bottom"
                         HorizontalAlignment="Center" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"
                         IsHitTestVisible="False"/>
                </Grid>
              </Grid>
            </Viewbox>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding HasFoe}" Value="True">
                <Setter TargetName="foe" Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock x:Name="EmptyHint" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="12"
                 Foreground="White" FontSize="12"
                 Text="{loc:T Taskbar.NoneOpen}">
        <TextBlock.Effect>
          <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.9" Color="Black"/>
        </TextBlock.Effect>
      </TextBlock>
    </Grid>
  </Border>
</Window>
