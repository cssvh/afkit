<Window x:Class="AFKit.Dialogs.ExtensionsWindow"
        FontFamily="{StaticResource Ui}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AFKit.Services"
        Title="{loc:T Ext.Title}" Width="640" Height="600" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{StaticResource Panel}" Foreground="{StaticResource Fg}">
  <Window.Resources>
    <!-- On/off switch (only in this dialog) -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="track" Width="36" Height="20" CornerRadius="10" Background="{StaticResource Bg}"
                    BorderBrush="{StaticResource LineHi}" BorderThickness="1">
              <Ellipse x:Name="thumb" Width="14" Height="14" Margin="2,0" Fill="{StaticResource FgDim}"
                       HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="{StaticResource Accent}"/>
                <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter TargetName="thumb" Property="Fill" Value="White"/>
                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="track" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel>
      <TextBlock x:Name="HeaderText" Text="{loc:T Ext.Title}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Fg}"/>
      <TextBlock x:Name="SessionHint" Foreground="{StaticResource FgDim}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
    </StackPanel>

    <!-- Install -->
    <StackPanel Grid.Row="1" x:Name="InstallPanel">
      <Label Content="{loc:T Ext.StoreLabel}"/>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="StoreBox" Tag="https://chromewebstore.google.com/detail/…" KeyDown="OnStoreKeyDown"/>
        <Button Grid.Column="1" Content="{loc:T Ext.Install}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                Click="OnInstallStoreClicked"/>
      </Grid>
      <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
        <Button Content="{loc:T Ext.FromFile}" Style="{StaticResource TextButton}" Margin="0,0,8,0" Click="OnInstallFileClicked"
                ToolTip="{loc:T Ext.FromFileTip}"/>
        <Button Content="{loc:T Ext.FromFolder}" Style="{StaticResource TextButton}" Click="OnInstallFolderClicked"
                ToolTip="{loc:T Ext.FromFolderTip}"/>
      </StackPanel>
    </StackPanel>

    <!-- Progress / errors -->
    <TextBlock Grid.Row="2" x:Name="StatusText" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>

    <!-- List -->
    <Border Grid.Row="3" Margin="0,14,0,0" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
      <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="ExtensionList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{StaticResource PanelHi}" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=OneWay}" VerticalAlignment="Center"
                              Margin="0,0,12,0" Click="OnToggleClicked" ToolTip="{loc:T Ext.ToggleTip}"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource Fg}"
                                 TextTrimming="CharacterEllipsis" ToolTip="{Binding Tooltip}"/>
                      <TextBlock x:Name="detail" Text="{Binding Detail}" Foreground="{StaticResource FgDim}" FontSize="11.5"
                                 TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="{loc:T Ext.Options}" Style="{StaticResource TextButton}" Padding="12,5" Margin="8,0,0,0"
                            VerticalAlignment="Center" IsEnabled="{Binding CanOpenOptions}" Click="OnOptionsClicked"
                            ToolTip="{Binding OptionsTooltip}" ToolTipService.ShowOnDisabled="True"/>
                    <Button Grid.Column="3" Content="{loc:T Ext.Remove}" Style="{StaticResource TextButton}" Padding="12,5" Margin="8,0,0,0"
                            VerticalAlignment="Center" Foreground="{StaticResource Danger}" Click="OnRemoveClicked"/>
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter TargetName="detail" Property="Foreground" Value="{StaticResource Warning}"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <TextBlock x:Name="EmptyText" Foreground="{StaticResource FgDim}" TextWrapping="Wrap" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" Visibility="Collapsed"
                   Text="{loc:T Ext.Empty}"/>
      </Grid>
    </Border>

    <!-- Footer -->
    <Grid Grid.Row="4" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Foreground="{StaticResource FgDim}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                 Text="{loc:T Ext.FooterNote}"/>
      <Button Grid.Column="1" x:Name="ReloadTabsButton" Content="{loc:T Ext.ReloadTabs}" Style="{StaticResource TextButton}"
              Margin="0,0,8,0" Click="OnReloadTabsClicked"
              ToolTip="{loc:T Ext.ReloadTabsTip}"/>
      <Button Grid.Column="2" Content="{loc:T Dlg.Close}" Style="{StaticResource TextButton}" IsCancel="True" Click="OnCloseClicked"/>
    </Grid>
  </Grid>
</Window>
