<Window x:Class="AFKit.Dialogs.CredentialDialog"
        FontFamily="{StaticResource Ui}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AFKit.Services"
        Title="{loc:T Cred.Title}" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource Panel}" Foreground="{StaticResource Fg}">
  <StackPanel Margin="20">
    <TextBlock x:Name="SiteText" TextWrapping="Wrap" Foreground="{StaticResource Fg}"/>
    <TextBlock x:Name="ChallengeText" TextWrapping="Wrap" Foreground="{StaticResource FgDim}" FontSize="11" Margin="0,4,0,0"/>
    <Label Content="{loc:T Cred.User}"/>
    <TextBox x:Name="UserBox"/>
    <Label Content="{loc:T Cred.Password}"/>
    <PasswordBox x:Name="PassBox"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="{loc:T Dlg.Cancel}" Style="{StaticResource TextButton}" IsCancel="True" Margin="0,0,8,0"/>
      <Button Content="{loc:T Dlg.SignIn}" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnOk"/>
    </StackPanel>
  </StackPanel>
</Window>
